# All three are optional — any provider with no key set here is skipped.
# Configure as many as you want; requests try them in this fixed order
# (Groq -> Cerebras -> OpenRouter) and automatically fall back to the next
# one on a rate-limit/quota error. At least one key is required for the
# app to work at all.
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_CEREBRAS_API_KEY=your_cerebras_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
